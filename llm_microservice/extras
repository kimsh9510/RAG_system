----------- Build docker in the root directory -----------
docker build -t my-llm-service -f llm_microservice/Dockerfile .


--------- Check Docker Images -----------
 docker images | grep my-llm-service

 ------------ Run Docker Container -----------
 docker run -it --rm \
  --name llm-service \
  -p 8080:8080 \
  my-llm-service

-------- Run the file inside the container -----------
python llm_microservice/client_example.py
